{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "upload:allow-download",
    "opener:allow-reveal-item-in-dir",
    "updater:default",
    "process:allow-restart",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-file-icon",
    "allow-quit",
    "allow-device-name",
    "allow-set-prefs",
    "allow-free-path",
    "allow-append-log",
    "allow-open-log-dir",
    "allow-mcp-ready",
    "allow-mcp-respond",
    "allow-read-local-file",
    "allow-recent-files",
    "allow-real-path",
    "allow-write-local-file",
    "allow-nearby-start",
    "allow-nearby-stop",
    "allow-nearby-peers",
    "allow-nearby-offers",
    "allow-nearby-send",
    "allow-nearby-answer",
    "allow-nearby-cancel",
    "allow-nearby-cleanup",
    "allow-nearby-open-settings"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drive",
  "version": "../package.json",
  "identifier": "com.chang.seadrive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Drive",
        "dragDropEnabled": false,
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0RjExMzBBMEI4OUY4OUIKUldTYitJa0xDaFB4OUQwYWN2djQ3M0ErV01QZ3VNTUhkWnJuWWJuYzJ0VHU1N00xS09wQWczSnkK",
      "endpoints": ["https://github.com/cksrlcks/seafile-custom/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
